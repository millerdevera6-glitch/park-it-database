# ============================================================================
# BrewPOS — Example Environment Configuration (.env.example)
# ============================================================================
# Quick Setup:
# 1. Copy this file to ".env" in the project root folder.
# 2. Replace "your_password_here" with your local PostgreSQL password.
# 3. Never upload your actual ".env" file or real password to GitHub.
#
# Format rules (this file is read like a Java .properties file):
# - Write values WITHOUT quotes:   DB_PASSWORD=myPass123   (not "myPass123")
# - If your password contains a backslash (\), write it twice (\\).
# ============================================================================

# PostgreSQL connection URL (Database: grp_brewposdb, Default Port: 5432)
DB_URL=jdbc:postgresql://localhost:5432/grp_brewposdb

# PostgreSQL username ("postgres" for standard local setup, or "brewpos_app" if you ran database/05_create_app_role.sql)
DB_USERNAME=postgres

# Password for DB_USERNAME (REQUIRED — enter your local PostgreSQL password in .env)
DB_PASSWORD=your_password_here

# Port where the BrewPOS web app runs (http://localhost:8081)
SERVER_PORT=8081
